{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ping",
      "destination": "/serverless-backend/ping.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/serverless-backend/index.ts"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/frontend/index.html"
    }
  ],
  "functions": {
    "serverless-backend/*.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
