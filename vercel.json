{
  "version": 2,
  "routes": [
    {
      "src": "/_/backend/(.*)",
      "dest": "/api/index.ts",
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts",
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
