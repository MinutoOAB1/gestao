{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ping-test",
      "destination": "/frontend/api/ping.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/frontend/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
