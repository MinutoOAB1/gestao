{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/server.ts": {
      "memory": 3008,
      "maxDuration": 15,
      "includeFiles": [
        "api/prisma-client/**/*",
        "backend/prisma/schema.prisma",
        "backend/dist/**/*"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.ts"
    }
  ]
}
