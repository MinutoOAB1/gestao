generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  storageQuotaGb       Int                   @default(3)
  usedStorageMb        Int                   @default(0)
  maxUsers             Int                   @default(3)
  plan                 String                @default("FREE")
  stripeCustomerId     String?               @unique
  stripeSubscriptionId String?               @unique
  subscriptionStatus   String?
  aiAnalysisLogs       AiAnalysisLog[]
  clients              Client[]
  clientChecklists     ClientChecklistItem[]
  clientNotes          ClientNote[]
  clientServiceLogs    ClientServiceLog[]
  clientTags           ClientTag[]
  contracts            Contract[]
  documents            Document[]
  auditLogs            DocumentAuditLog[]
  events               Event[]
  financialRecords     FinancialRecord[]
  folders              Folder[]
  invoices             Invoice[]
  notifications        Notification[]
  partnerships         Partnership[]
  processes            Process[]
  processLabels        ProcessLabel[]
  templates            Template[]
  settings             TenantSettings?
  timeEntries          TimeEntry[]
  users                User[]
  financialCategories  FinancialCategory[]
  chatChannels         ChatChannel[]
  directMessages       DirectMessage[]
  valueChain           ValueChain?
}

model User {
  id                      String            @id @default(uuid())
  email                   String            @unique
  password                String
  name                    String
  role                    String            @default("LAWYER")
  avatar                  String?
  cpf                     String?
  birthDate               DateTime?
  bio                     String?
  phone                   String?
  mobile                  String?
  address                 String?
  oabNumber               String?
  oabState                String?
  specialties             String?
  twoFactorSecret         String?
  twoFactorEnabled        Boolean           @default(false)
  permissions             String?
  tenantId                String
  storageQuotaGb          Int               @default(1)
  usedStorageMb           Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  googleCalendarConnected Boolean           @default(false)
  googleRefreshToken      String?
  resetExpires            DateTime?
  resetToken              String?
  aiAnalysisLogs          AiAnalysisLog[]
  documents               Document[]        @relation("DocumentCreator")
  documentComments        DocumentComment[]
  loginHistory            LoginHistory[]
  sentNotifications       Notification[]    @relation("SentNotifications")
  receivedNotifications   Notification[]    @relation("ReceivedNotifications")
  processComments         ProcessComment[]
  timeEntries             TimeEntry[]
  tenant                  Tenant            @relation(fields: [tenantId], references: [id])
  userFiles               UserFile[]
}

model Notification {
  id          String   @id @default(uuid())
  type        String   @default("MENTION")
  title       String
  message     String?
  isRead      Boolean  @default(false)
  entityType  String?
  entityId    String?
  userId      String
  createdById String?
  tenantId    String
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("SentNotifications", fields: [createdById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  user        User     @relation("ReceivedNotifications", fields: [userId], references: [id])
}

model Process {
  id            String             @id @default(uuid())
  number        String?
  title         String
  description   String?
  status        String             @default("OPEN")
  value         Float?
  court         String?
  area          String?
  deadline      DateTime?
  assignedTo    String?
  kanbanColumn  String             @default("novo")
  kanbanOrder   Int                @default(0)
  clientId      String?
  tenantId      String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  completedAt   DateTime?
  googleEventId String?
  datajudId     String?
  isMonitored   Boolean            @default(false)
  lastSyncAt    DateTime?
  client        Client?            @relation(fields: [clientId], references: [id])
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  checklists    ProcessChecklist[]
  comments      ProcessComment[]
  notes         ProcessNote[]
  updates       ProcessUpdate[]
  timeEntries   TimeEntry[]
  labels        ProcessLabel[]     @relation("ProcessLabels")

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([kanbanColumn])
  @@index([tenantId, createdAt])
  @@index([tenantId, deadline])
}

model ProcessNote {
  id        String   @id @default(uuid())
  content   String
  color     String   @default("yellow")
  isPinned  Boolean  @default(false)
  processId String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
}

model ProcessUpdate {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String
  type        String   @default("MOVIMENTO")
  isImportant Boolean  @default(false)
  processId   String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
}

model ProcessChecklist {
  id        String                 @id @default(uuid())
  title     String                 @default("Checklist")
  processId String
  createdAt DateTime               @default(now())
  process   Process                @relation(fields: [processId], references: [id], onDelete: Cascade)
  items     ProcessChecklistItem[]
}

model ProcessChecklistItem {
  id          String           @id @default(uuid())
  text        String
  completed   Boolean          @default(false)
  order       Int              @default(0)
  checklistId String
  checklist   ProcessChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model ProcessLabel {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#3B82F6")
  tenantId  String
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  processes Process[] @relation("ProcessLabels")
}

model ProcessComment {
  id        String   @id @default(uuid())
  content   String
  processId String
  userId    String
  createdAt DateTime @default(now())
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Client {
  id               String                @id @default(uuid())
  name             String
  email            String?
  phone            String?
  document         String?
  address          String?
  leadSource       String?
  referredBy       String?
  demandType       String?
  demandSummary    String?
  factsDescription String?
  urgencyLevel     String?
  rg               String?
  birthDate        DateTime?
  city             String?
  state            String?
  zipCode          String?
  occupation       String?
  leadStatus       String                @default("NOVO")
  nextAction       String?
  nextActionDate   DateTime?
  internalNotes    String?
  tenantId         String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  status           String                @default("ATIVO")
  customFields     Json?
  asaasCustomerId  String?
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  activities       ClientActivity[]
  checklistItems   ClientChecklistItem[]
  notes            ClientNote[]
  serviceLogs      ClientServiceLog[]
  tags             ClientTag[]
  contracts        Contract[]
  financialRecords FinancialRecord[]
  invoices         Invoice[]
  processes        Process[]
  portalAccess     ClientPortalAccess?

  @@index([tenantId])
  @@index([status])
  @@index([document])
  @@index([tenantId, createdAt])
}

model ClientActivity {
  id          String   @id @default(uuid())
  type        String
  description String
  metadata    Json?
  clientId    String
  tenantId    String
  userId      String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([tenantId])
}

model ClientTag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  clientId  String
  tenantId  String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model ClientNote {
  id          String   @id @default(uuid())
  content     String
  priority    String   @default("NORMAL")
  isUrgent    Boolean  @default(false)
  clientId    String
  createdBy   String
  createdById String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model ClientServiceLog {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  type            String   @default("MEETING")
  durationMinutes Int?
  summary         String
  clientId        String
  tenantId        String
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

model ClientChecklistItem {
  id        String   @id @default(uuid())
  text      String
  completed Boolean  @default(false)
  clientId  String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model FinancialRecord {
  id                 String    @id @default(uuid())
  type               String
  category           String
  amount             Float
  description        String
  date               DateTime  @default(now())
  accrualDate        DateTime  @default(now()) // Regime de Competência
  paymentDate        DateTime?                   // Regime de Caixa (Liquidação)
  costCenter         String?                     // Centro de Custo
  status             String    @default("PENDING")
  isRecurring        Boolean   @default(false)
  recurrenceType     String?
  totalInstallments  Int?
  currentInstallment Int?
  recurringEndDate   DateTime?
  parentRecordId     String?
  isUrgent           Boolean   @default(false)
  tenantId           String
  clientId           String?
  issAmount          Float?    @default(0)
  irrfAmount         Float?    @default(0)
  pisAmount          Float?    @default(0)
  cofinsAmount       Float?    @default(0)
  netAmount          Float?    // Valor líquido após retenções
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  cancelledAt        DateTime?                   // Data de estorno/cancelamento
  notes              String?
  categoryId         String?
  categoryRef        FinancialCategory? @relation(fields: [categoryId], references: [id])
  client             Client?   @relation(fields: [clientId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  invoices           Invoice[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([date])
  @@index([accrualDate])
  @@index([paymentDate])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, type])
}

model Invoice {
  id                String           @id @default(uuid())
  asaasId           String           @unique
  amount            Float
  status            String
  dueDate           DateTime
  paymentLink       String?
  invoiceUrl        String?
  bankSlipUrl       String?
  pixQrCode         String?
  pixText           String?
  paymentMethod     String           @default("BOLETO")
  clientId          String
  financialRecordId String?
  tenantId          String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  client            Client           @relation(fields: [clientId], references: [id])
  financialRecord   FinancialRecord? @relation(fields: [financialRecordId], references: [id])
  tenant            Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([asaasId])
}

model Folder {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  tenantId  String
  isLocked  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderHierarchy")
  tenant    Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([parentId])
}

model Document {
  id           String             @id @default(uuid())
  name         String
  type         String
  size         String
  url          String?
  folderId     String?
  tenantId     String
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  kanbanStatus String             @default("TODO")
  isLocked     Boolean            @default(false)
  allowedRoles String?
  createdBy    User?              @relation("DocumentCreator", fields: [createdById], references: [id])
  folder       Folder?            @relation(fields: [folderId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  auditLogs    DocumentAuditLog[]
  comments     DocumentComment[]

  @@index([tenantId])
  @@index([folderId])
  @@index([type])
}

model DocumentComment {
  id         String   @id @default(uuid())
  content    String
  documentId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
}

model DocumentAuditLog {
  id         String    @id @default(uuid())
  action     String
  details    String?
  documentId String?
  userId     String
  userName   String?
  tenantId   String
  createdAt  DateTime  @default(now())
  document   Document? @relation(fields: [documentId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
}

model Event {
  id              String               @id @default(uuid())
  title           String
  description     String?
  start           DateTime
  end             DateTime
  type            String
  color           String?
  completed       Boolean              @default(false)
  priority        String               @default("MEDIUM")
  location        String?
  reminderMinutes Int?                 @default(30)
  createdById     String?
  createdByName   String?
  processId       String?
  processNumber   String?
  tenantId        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  reminderSent    Boolean              @default(false)
  clientId        String?
  clientName      String?
  status          String               @default("ATIVO")
  googleEventId   String?              @unique
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  assignees       EventAssignee[]
  checklistItems  EventChecklistItem[]

  @@index([tenantId])
  @@index([start])
  @@index([processId])
}

model EventChecklistItem {
  id        String   @id @default(uuid())
  text      String
  completed Boolean  @default(false)
  order     Int      @default(0)
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventAssignee {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  userName  String
  userEmail String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Contract {
  id               String   @id @default(uuid())
  number           String
  title            String
  description      String?
  status           String   @default("INITIATED")
  value            Float
  clientId         String?
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  area             String?
  autentiqueId     String?
  autentiqueStatus String?
  client           Client?  @relation(fields: [clientId], references: [id])
  tenant           Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([tenantId, area])
}

model Partnership {
  id           String                   @id @default(uuid())
  name         String
  initials     String
  type         String
  percentage   Float?
  fixedAmount  Float?
  color        String                   @default("bg-blue-500")
  email        String?
  phone        String?
  notes        String?
  active       Boolean                  @default(true)
  tenantId     String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  transactions PartnershipTransaction[]

  @@index([tenantId])
}

model PartnershipTransaction {
  id                String      @id @default(uuid())
  amount            Float
  description       String?
  status            String      @default("PENDING")
  dueDate           DateTime?
  paidDate          DateTime?
  partnerId         String
  financialRecordId String?
  tenantId          String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  partner           Partnership @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([tenantId])
}

model Template {
  id               String   @id @default(uuid())
  title            String
  description      String?
  content          String
  category         String
  icon             String   @default("FileText")
  iconColor        String   @default("blue")
  variables        String?
  docxPath         String?
  previewImagePath String?
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([category])
}

model TenantSettings {
  id                 String  @id @default(uuid())
  officeName         String  @default("My Office")
  cnpj               String?
  email              String?
  website            String?
  language           String  @default("pt-BR")
  timezone           String  @default("America/Sao_Paulo")
  dateFormat         String  @default("DD/MM/YYYY")
  emailNotifications Boolean @default(true)
  processUpdates     Boolean @default(true)
  deadlineReminders  Boolean @default(true)
  twoFactor          Boolean @default(false)
  loginAlerts        Boolean @default(true)
  tenantId           String  @unique
  letterheadUrl      String?
  asaasApiKey        String?
  logoUrl            String?
  autentiqueApiKey   String?
  tenant             Tenant  @relation(fields: [tenantId], references: [id])
}

model TimeEntry {
  id           String   @id @default(uuid())
  description  String
  duration     Int
  date         DateTime
  processId    String?
  processTitle String?
  userId       String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  process      Process? @relation(fields: [processId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([processId])
}

model AiAnalysisLog {
  id             String   @id @default(uuid())
  contractName   String?
  contractText   String
  analysisResult String
  overallScore   Int
  userId         String?
  tenantId       String
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  deviceHash String?
  location   String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceHash])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  userId     String
  userName   String?
  tenantId   String
  details    String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model UserFile {
  id        String   @id @default(uuid())
  name      String
  fileName  String
  mimeType  String
  sizeBytes Int
  url       String
  folder    String?
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, folder])
}

model ClientPortalAccess {
  id           String   @id @default(uuid())
  clientId     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([email])
}

model FinancialCategory {
  id        String   @id @default(uuid())
  name      String
  type      String   // 'INCOME' | 'EXPENSE'
  code      String?  // Ex: 1.1.1
  parentId  String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  defaultIss      Float?    @default(0)
  defaultIrrf     Float?    @default(0)
  defaultPis      Float?    @default(0)
  defaultCofins   Float?    @default(0)
  
  parent    FinancialCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  FinancialCategory[] @relation("CategoryHierarchy")
  records   FinancialRecord[]
  tenant    Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([name, type, tenantId, parentId])
  @@index([tenantId])
}

model ChatChannel {
  id        String        @id @default(uuid())
  name      String
  type      String        @default("GENERAL")
  processId String?
  tenantId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([processId])
}

model ChatMessage {
  id           String      @id @default(uuid())
  content      String
  channelId    String
  senderId     String
  senderName   String
  senderAvatar String?
  fileName     String?
  fileUrl      String?
  fileSize     String?
  fileType     String?
  replyToId    String?
  reactions    String?
  isPinned     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  channel      ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model DirectMessage {
  id           String   @id @default(uuid())
  content      String
  senderId     String
  senderName   String
  senderAvatar String?
  recipientId  String
  isRead       Boolean  @default(false)
  tenantId     String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([senderId, recipientId])
}

model Changelog {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  version     String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ValueChain {
  id          String   @id @default(uuid())
  nodes       Json     // Store nodes JSON
  connections Json     // Store connections JSON
  tenantId    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

